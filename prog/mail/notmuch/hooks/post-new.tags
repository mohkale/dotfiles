# Tag any mail in the bin as deleted.
-new       +deleted -- folder:/\[Gmail\]/ and folder:/Bin$/
-new +spam          -- folder:/\[Gmail\]/ and folder:/Spam$/
-new       +deleted -- folder:/^kisara/Trash/


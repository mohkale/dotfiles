mqtt:
  prefix: lnxlink
  # XXXX: Replace with the hostname of the client
  clientId: clientid
  server: localhost
  port: 1883
  auth:
    # XXXX: Enable username and password authentication
    user: username
    pass: ""

    # XXXX: Enable TLS connections over the public internet
    #tls: true
    #keyfile: /home/mohkale/.config/lnxlink/certs/publisher-key.pem
    #certfile: /home/mohkale/.config/lnxlink/certs/publisher-cert.pem
    #ca_certs: /home/mohkale/.config/lnxlink/ca-certificates/consumer-cert.pem

  discovery:
    enabled: true
    prefix: homeassistant
  lwt:
    enabled: true
    qos: 1
    retain: false
  clear_on_off: true

update_interval: 5
update_on_change: false

hass_url: null
hass_api: null
modules: null
custom_modules: null
exclude:
- audio_select
- battery
- beacondb
- boot_select
- brightness
- fullscreen
- gpio
- gpu
- idle
- inference_time
- ir_remote
- keep_alive
- keyboard_hotkeys
- media
- mouse
- notify
- power_profile
- restful
- screen_onoff
- screenshot
- send_keys
- speech_recognition
- systemd
- webcam
- xdg_open
- statistics
# include:
# - bluetooth
# - interface
# - network
# - steam
# - wol

settings:
  statistics: null
  disk_usage:
    include_disks: []
    exclude_disks: []
    detailed_info: true
  systemd: null
  docker:
    include: []
    exclude: []
    check_update: 24
    expose_controls: true
  mounts:
    autocheck: false
    directories: []
  steam:
    library: /home/mohkale/.local/share/Steam/config/libraryfolders.vdf
  bash:
    allow_any_command: false
    expose:
    - name: inhibit-screen-lock
      type: switch
      command: systemctl --user is-active lnxlink-screen-lock-inhibitor-daemon.service
        | grep -v inactive
      command_on: systemctl start --user lnxlink-screen-lock-inhibitor-daemon.service
      command_off: systemctl stop --user lnxlink-screen-lock-inhibitor-daemon.service

